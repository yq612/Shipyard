# 前面有 nginx 时的参考配置。配合：
#   compose.yaml：   environment 里设 HOST: 127.0.0.1（容器用 host 网络，只监听本机）
#   config.yaml：    access.trustProxy: true
#                    access.proxyIps: [127.0.0.1]
#                    access.allowedOrigins: [https://deploy.example.internal]
#                    access.allowIps 里去掉 127.0.0.1 / ::1：请求都经 nginx 进来，本机地址不代表任何操作者
server {
    listen 443 ssl;
    server_name deploy.example.internal;

    # ssl_certificate / ssl_certificate_key ...

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # 直接覆盖，不追加：客户端伪造的 X-Forwarded-For 不会被带进来。
        # 不能省：没有它服务识别不出来源 IP，所有执行请求都会被拒绝。
        proxy_set_header X-Forwarded-For $remote_addr;

        # SSE（进度、日志）不能被缓冲，也不能因为空闲被断开
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }
}
