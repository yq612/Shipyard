{
  "name": "shipyard",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "deploy": "bun run scripts/deploy.ts",
    "dev:server": "bun --watch apps/server/src/main.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun apps/server/src/main.ts",
    "test": "bun test",
    "typecheck": "tsc -p packages/shared --noEmit && tsc -p apps/server --noEmit && tsc -p apps/web --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "~5.9.3"
  }
}
